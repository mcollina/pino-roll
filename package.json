{
  "name": "pino-roll",
  "version": "4.0.0",
  "description": "A Pino transport that automatically rolls your log files",
  "main": "pino-roll.js",
  "scripts": {
    "dev": "node --test --watch",
    "lint": "eslint",
    "test": "eslint && node --test --test-concurrency=1",
    "test-only": "node --test --test-concurrency=1",
    "test-ci": "c8 --reporter=lcovonly node --test --test-concurrency=1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcollina/pino-roll.git"
  },
  "keywords": [
    "pino",
    "transport"
  ],
  "author": "Damien Simonin Feugas <damien.feugas@gmail.com>",
  "contributors": [
    "Matteo Collina <hello@matteocollina.com>"
  ],
  "license": "MIT",
  "dependencies": {
    "sonic-boom": "^4.0.1",
    "temporal-fmt": "0.6.0",
    "temporal-polyfill": "^1.0.3"
  },
  "devDependencies": {
    "@fastify/pre-commit": "^2.2.0",
    "c8": "^10.1.3",
    "eslint": "^9.33.0",
    "neostandard": "^0.12.2",
    "pino": "^10.0.0"
  },
  "pre-commit": [
    "lint"
  ]
}
